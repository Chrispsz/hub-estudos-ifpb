# Copie para .env e preencha UMA das opções (o tutor funciona com qualquer uma).
# NÃO há nenhuma dependência do SDK Z.ai — 100% portável para qualquer servidor.

# Opção A — Google Gemini (RECOMENDADO: key grátis no AI Studio, sem cartão,
#           tier grátis com VISÃO nativa — leitura de prints + texto com 1 key só)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Opção B — OpenRouter (dezenas de modelos grátis com 1 key)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Opção C — API pública da Z.ai (tier grátis no glm-4.5-flash)
# https://z.ai
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.5-flash

# Prisma (scaffold opcional — nada no runtime usa banco hoje)
DATABASE_URL="file:./db/custom.db"
