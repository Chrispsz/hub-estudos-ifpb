// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Configurações da casa — DADO DO DONO no servidor (nunca código).
// 1ª moradora: a chave do Gemini ("a chave perfeita", Task 214) — entra pela
// UI (Configurações → Inteligência da casa), mora aqui, volta mascarada e é
// removível. Nada de chave hard-coded ou no git.
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// Memória do Tutor IA — conversas salvas por disciplina (leve: podadas em 40/disciplina)
// Nota Fase 1: models de template (User/Post) removidos — nunca foram usados.
model TutorMessage {
  id          String   @id @default(cuid())
  discipline  String // código da disciplina (ex.: TEC.1687) — chave estável
  role        String // 'user' | 'assistant'
  content     String
  model       String? // modelo que gerou a resposta (ex.: Nemotron 3 Super)
  // TIPO DO PEDIDO (Task 227 — "rastrear se o tutor foi usado… orientação ou
  // resposta"): heurística LOCAL na pergunta do aluno — zero IA extra, zero
  // custo. 'resposta' = pede entrega pronta (o algoritmo lê dependência);
  // 'orientacao' = dúvida/caminho (uso saudável); 'outro' = neutro/legado.
  kind        String   @default("outro")
  createdAt   DateTime @default(now())

  @@index([discipline, createdAt])
}

// Painel de combustível (Task 218) — uso DIÁRIO por modelo da key do dono.
// Uma linha por (modelo, dia). O roteador do tutor lê ANTES de chamar o Gemini
// e pula o modelo que já queimou o RPD do painel "Limites de taxa" do AI
// Studio (limites reais conferidos pelo dono em 14/10/2026) — assim o 429
// nunca chega: o próximo elo assume ANTES da falha, não depois.
model AiUsage {
  id        String   @id @default(cuid())
  model     String // chave de quota (ex.: gemini-3.8-flash; aliases resolvem p/ o id real)
  day       String // "AAAA-MM-DD" no fuso America/Sao_Paulo (RPD do Google reseta à meia-noite PT — aproximação de 1h)
  count     Int      @default(0) // requisições registradas hoje
  exhausted Boolean  @default(false) // 429/RESOURCE_EXHAUSTED visto hoje → pular até o dia virar
  updatedAt DateTime @updatedAt

  @@unique([model, day])
  @@index([day])
}